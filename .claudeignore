# ==============================================================================
# .claudeignore - Claude Code Context Boundary & Token Protection Shield
# Prevents context explosion, unnecessary token billing & background scanning
# ==============================================================================

# 1. Dependencies & Package Managers
node_modules/
vendor/
target/
.venv/
venv/
env/
__pypackages__/

# 2. Build Outputs & Compiled Artifacts
dist/
build/
out/
.next/
.turbo/
.nuxt/
.output/
coverage/
bin/
obj/
*.bundle.js
**/*.min.js
**/*.min.css
**/*.map
*.tsbuildinfo

# 3. Lockfiles & Database Dumps
package-lock.json
pnpm-lock.yaml
yarn.lock
bun.lockb
composer.lock
Gemfile.lock
Cargo.lock
poetry.lock
Pipfile.lock
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.csv
*.tsv
*.parquet

# 4. Logs & Caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
.pytest_cache/
__pycache__/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 5. Heavy Media, Binary & Archive Files
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.svg
*.mp4
*.mp3
*.wav
*.avi
*.mov
*.pdf
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.woff
*.woff2
*.ttf
*.eot
*.exe
*.dll
*.so
*.dylib

# 6. Environment & Sensitive Configs
.env*
!.env.example

# 7. Git & Agent Internals
.git/
.svn/
.hg/
.claude/worktrees/
.claude/transcripts/
.claude/outputs/
