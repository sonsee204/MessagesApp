# Khóa API Klipy để dùng kho Nhãn dán (Sticker) — đăng ký miễn phí tại https://klipy.com/developers
VITE_KLIPY_API_KEY=your_klipy_api_key_here

# === Firebase Cloud Messaging (FCM) — cấu hình theo docs/call-feature-setup.md mục 3 ===
# Nếu để trống, push notification khi user offline sẽ bị disable (gọi realtime vẫn hoạt động)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# === WebRTC TURN Server — Relay qua NAT khắc nghiệt (symmetric NAT / firewall) ===
# Khi để trống: chỉ dùng STUN, cuộc gọi có thể không kết nối được qua NAT khắc nghiệt.
# Khuyến nghị: Open Relay (miễn phí) https://www.metered.ca/tools/openrelay/ hoặc tự host coturn.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

