PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/appmessaging
JWT_SECRET=appmessaging_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Cloudinary (Signed Direct Upload cho media chat)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Firebase Cloud Messaging (FCM) — theo docs/call-feature-setup.md mục 2 ===
# Lấy từ Firebase Console → Project Settings → Service accounts → Generate new private key
# Nếu để trống, app vẫn khởi động bình thường — chỉ thiếu push notification khi user offline
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"
