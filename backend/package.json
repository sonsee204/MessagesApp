{
  "name": "appmessaging-backend",
  "version": "1.0.0",
  "description": "Real-time Messaging Backend with Express, TypeScript, MongoDB (Mongoose) & Socket.IO",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
